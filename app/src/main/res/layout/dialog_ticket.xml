<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Encabezado del Ticket -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="================================\n        ABARROTES PÉREZ\n================================"
                android:textAlignment="center"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tvTicketFechaHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"/>

            <!-- Cabeceras de columnas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--------------------------------\nCANT| DESCRIPCIÓN  | P.U. | IMP\n--------------------------------"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="#000000"/>

            <!-- Contenedor dinámico de productos -->
            <LinearLayout
                android:id="@+id/llTicketProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--------------------------------"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="#000000"/>

            <!-- Totales -->
            <TextView
                android:id="@+id/tvTicketTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewEnd"
                android:typeface="monospace"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tvTicketRecibido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewEnd"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tvTicketCambio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewEnd"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>



    <!-- NUEVO: Selector de cliente para WhatsApp -->
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
android:text="Selecciona un cliente para enviar ticket:"
android:textColor="#333333"
android:textSize="14sp"
android:textStyle="bold" />

<Spinner
android:id="@+id/spinnerClientesTicket"
android:layout_width="match_parent"
android:layout_height="48dp"
android:layout_marginBottom="8dp"
android:background="@android:drawable/btn_dropdown" />

    <!-- Botón de WhatsApp que ya tenías -->
<com.google.android.material.button.MaterialButton
android:id="@+id/btnGenerarPdfWhatsApp"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="ENVIAR POR WHATSAPP"
android:textColor="#FFFFFF"
app:backgroundTint="#25D366" />
</LinearLayout>