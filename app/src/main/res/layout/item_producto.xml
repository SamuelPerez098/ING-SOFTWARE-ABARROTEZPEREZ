<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Nombre del Producto"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEditar"
                style="@style/Widget.Abarrotes.IconAccion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Editar producto"
                app:icon="@drawable/ic_lapiz"
                app:iconTint="@color/acento_inventario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemPromo"
                style="@style/Widget.Abarrotes.IconAccion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Aplicar descuento"
                app:icon="@drawable/ic_descuento"
                app:iconTint="@color/acento_inventario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEliminar"
                style="@style/Widget.Abarrotes.IconAccion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Eliminar producto"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/estado_peligro" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Código: 123456789"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemPrecio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Precio: $0.00"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemStock"
                style="@style/Widget.Abarrotes.Estado.Neutro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock: 0" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
